 object SrtText {
-    fun decode(bytes: ByteArray): String {
+    /**
+     * [encoding] is "auto" or a charset name such as "UTF-8", "windows-1250" (Central European /
+     * Serbian-Croatian Latin), "windows-1251" (Cyrillic) or "windows-1254" (Turkish).
+     */
+    fun decode(bytes: ByteArray, encoding: String = "auto"): String {
+        if (encoding != "auto") {
+            return try {
+                String(bytes, Charset.forName(encoding))
+            } catch (e: Exception) {
+                decode(bytes, "auto")
+            }
+        }
         return try {
             val decoder = Charsets.UTF_8.newDecoder()
                 .onMalformedInput(CodingErrorAction.REPORT)
                 .onUnmappableCharacter(CodingErrorAction.REPORT)
             decoder.decode(ByteBuffer.wrap(bytes)).toString()
         } catch (e: CharacterCodingException) {
-            String(bytes, Charset.forName("windows-1254"))
+            String(bytes, Charset.forName(guessLegacy(bytes)))
+        }
+    }
+
+    // Not UTF-8: decide between Turkish (1254) and Central European (1250: Serbian/Croatian/Bosnian).
+    private fun guessLegacy(bytes: ByteArray): String {
+        var turkish = 0
+        var slavic = 0
+        for (b in bytes) {
+            when (b.toInt() and 0xFF) {
+                0xFE, 0xFD, 0xDD, 0xDE -> turkish++          // ş ı İ Ş
+                0x8A, 0x8E, 0x9A, 0x9E, 0xC6, 0xC8, 0xE6, 0xE8 -> slavic++ // Š Ž š ž Ć Č ć č
+            }
         }
+        return if (turkish > slavic) "windows-1254" else "windows-1250"
     }
 }
