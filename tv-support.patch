+        val row = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER
+        }
+        val parts = listOf(
+            keyChip("↓ −1 s"),
+            keyChip("← −0,1 s"),
+            keyChip("Sync " + fmtOffset(offsetMs), bold = true, highlight = true),
+            keyChip("+0,1 s →"),
+            keyChip("+1 s ↑"),
+            keyChip("OK  Reset")
+        )
+        parts.forEachIndexed { i, v -> row.addView(v, lp(start = if (i == 0) 0f else 6f)) }
+        return row
+    }
+
+    private fun listBlock(list: List<String>, sel: Int): View {
+        val col = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.CENTER_HORIZONTAL
+        }
+        if (list.isEmpty()) {
+            col.addView(keyChip("Nema titlova — dodaj ih u Subly+ (Postavke)"))
+            return col
+        }
+        list.take(5).forEachIndexed { i, name ->
+            val t = keyChip(name, bold = i == sel, highlight = i == sel).apply {
+                maxLines = 1
+                ellipsize = android.text.TextUtils.TruncateAt.MIDDLE
+                maxWidth = px(if (tv) 520f else 320f)
+            }
+            col.addView(t, lp(top = if (i == 0) 0f else 6f))
+        }
+        return col
+    }
+}
