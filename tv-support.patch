+import com.cybertkr.suboverlay.R
+import java.util.Locale
+
+/**
+ * Small pill-shaped menu drawn at the top of the screen (Stremio-like).
+ * Row 1: three icons (subtitles / sync / settings).
+ * Row 2 (optional): the sync controls, or the list of recent subtitles.
+ * It is display-only; keys are handled in OverlayService.
+ */
+class MenuBar(private val context: Context) {
+
+    private val density = context.resources.displayMetrics.density
+    private fun px(v: Float) = (v * density).toInt()
+
+    private val tv = context.packageManager.hasSystemFeature(PackageManager.FEATURE_LEANBACK)
+    private val textSp = if (tv) 18f else 14f
+
+    private val accentStart = Color.parseColor("#2E7CF6")
+    private val accentEnd = Color.parseColor("#14B8A6")
+
+    private val card = LinearLayout(context).apply {
+        orientation = LinearLayout.VERTICAL
+        gravity = Gravity.CENTER_HORIZONTAL
+        setPadding(px(14f), px(10f), px(14f), px(12f))
+        background = GradientDrawable().apply {
+            setColor(Color.parseColor("#E60F1419"))
+            cornerRadius = px(22f).toFloat()
+        }
+        visibility = View.GONE
+    }
+
+    fun view(): View = card
+
+    /** mode: 0 = icons only, 1 = sync row, 2 = recent subtitles list */
+    fun render(mode: Int, selected: Int, offsetMs: Long, list: List<String>, listSel: Int) {
+        card.removeAllViews()
+        card.addView(iconRow(selected))
+        when (mode) {
+            1 -> card.addView(syncRow(offsetMs), lp(top = 10f))
+            2 -> card.addView(listBlock(list, listSel), lp(top = 10f))
+            else -> {}
+        }
+    }
+
+    private fun lp(top: Float = 0f, start: Float = 0f): LinearLayout.LayoutParams =
+        LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.WRAP_CONTENT,
+            LinearLayout.LayoutParams.WRAP_CONTENT
+        ).apply { topMargin = px(top); marginStart = px(start) }
+
+    private fun chipBackground(active: Boolean): GradientDrawable =
+        if (active) {
+            GradientDrawable(
+                GradientDrawable.Orientation.LEFT_RIGHT,
+                intArrayOf(accentStart, accentEnd)
+            ).apply { cornerRadius = px(16f).toFloat() }
+        } else {
+            GradientDrawable().apply {
+                setColor(Color.parseColor("#26FFFFFF"))
+                cornerRadius = px(16f).toFloat()
+            }
+        }
+
+    private fun iconRow(selected: Int): View {
+        val row = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER
+        }
+        val items = listOf(
+            R.drawable.ic_menu_download to "Titl",
+            R.drawable.ic_menu_sync to "Sync",
+            R.drawable.ic_menu_settings to "Postavke"
+        )
+        items.forEachIndexed { i, (icon, label) ->
+            val chip = LinearLayout(context).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(px(14f), px(8f), px(16f), px(8f))
+                background = chipBackground(i == selected)
+            }
+            val iv = ImageView(context).apply {
+                setImageResource(icon)
+                setColorFilter(Color.WHITE)
+            }
