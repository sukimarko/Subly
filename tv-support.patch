+    // Fallback for players whose seek bar has a different id: any node with a
+    // millisecond-sized range (> 1 minute) is treated as the seek bar.
+    private fun findRangeNode(node: AccessibilityNodeInfo): AccessibilityNodeInfo? {
+        val ri = node.rangeInfo
+        if (ri != null && ri.max >= 60_000f) return node
+        for (i in 0 until node.childCount) {
+            val c = node.getChild(i) ?: continue
+            findRangeNode(c)?.let { return it }
+        }
+        return null
+    }
