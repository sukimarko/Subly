+    // Debug helper: `adb logcat -s SublySync` shows what the player exposes.
+    private fun dumpTreeThrottled(root: AccessibilityNodeInfo) {
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastDump < 8000L) return
+        lastDump = now
+        Log.d(TAG, "No seek bar found. Tree of ${root.packageName}:")
+        var budget = 80
+        fun walk(n: AccessibilityNodeInfo, depth: Int) {
+            if (budget <= 0) return
+            budget--
+            val ri = n.rangeInfo
+            Log.d(
+                TAG,
+                "  ".repeat(depth) + "${n.className} id=${n.viewIdResourceName} " +
+                    "text=${n.text} desc=${n.contentDescription} " +
+                    (if (ri != null) "range=${ri.current}/${ri.max}" else "")
+            )
+            for (i in 0 until n.childCount) {
+                val c = n.getChild(i) ?: continue
+                walk(c, depth + 1)
+            }
+        }
+        walk(root, 0)
+    }
